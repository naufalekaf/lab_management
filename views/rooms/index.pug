extends ../layouts/main

block content
    .card.user-card

        .card-body

            // HEADER AREA (tanpa card-header)
            .d-flex.justify-content-between.align-items-center.mb-4

                h3.text-white.mb-0.app-name Manajemen Ruangan

                a.btn.btn-primary(
                    href="/rooms/create"
                )

                    | Tambah Ruangan

            // TABLE
            .table-responsive
                table.table.table-dark.table-hover.table-borderless

                    thead
                        tr
                            th No
                            th Kode Ruangan
                            th Nama Ruangan
                            th Detail Ruangan
                            th.text-center Aksi

                    tbody
                        each item, index in rooms
                            tr
                                td= index + 1
                                td.font-weight-bold= item.room_code
                                td= item.room_name
                                td= item.room_description

                                td.text-center
                                    a.btn.btn-sm.btn-warning.mr-2(
                                        href=`/rooms/edit/${item.id}`
                                    )
                                        i.fas.fa-edit

                                    a.btn.btn-sm.btn-danger(
                                        href=`/rooms/delete/${item.id}`
                                    )
                                        i.fas.fa-trash