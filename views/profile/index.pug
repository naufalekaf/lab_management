doctype html
html
  head
    title Profile

    link(
      rel="stylesheet",
      href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css"
    )

    link(
      rel="stylesheet",
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"
    )

    link(
      rel="stylesheet",
      href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css"
    )

    style.
        body {
            background: linear-gradient(135deg, #0f172a, #1e293b);
        }

        .profile-box {
            width: 450px;
            margin: 80px auto;
        }

        .card {
            border-radius: 16px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.35);
            border: none;
            background: rgba(255,255,255,0.08);
            backdrop-filter: blur(10px);
        }

        .card-body {
            color: #fff;
        }

        .form-control {
            border-radius: 10px;
            height: 45px;
        }

        .btn-primary {
            border-radius: 10px;
            height: 45px;
            font-weight: 600;
        }

        label {
            color: #cbd5e1;
            font-size: 13px;
        }

        .input-gray {
            background-color: rgb(15, 23, 42); /* abu-abu */
            color: #ffffff; /* warna teks input */
            border: none;
            border-block-color: #1f6feb;
        }

        .input-gray::placeholder {
            color: #ffffff; /* placeholder putih */
            opacity: 1; /* biar tidak pudar */
        }

        /* optional biar lebih enak dilihat */
        .input-gray:focus {
            background-color: rgb(15, 23, 42);
        !important;
            color: #fff !important;
            border-color: #adb5bd !important;
            box-shadow: none !important;
            outline: none !important;
        }

        .input-gray:valid,
        .input-gray:invalid {
            background-color: rgb(15, 23, 42);!important;
            color: #fff !important;
        }

        /* 🔥 autofill Chrome (INI PENTING) */
        .input-gray:-webkit-autofill,
        .input-gray:-webkit-autofill:hover,
        .input-gray:-webkit-autofill:focus,
        .input-gray:-webkit-autofill:active {
            -webkit-box-shadow: 0 0 0 1000px #0f172a inset !important;
            -webkit-text-fill-color: #fff !important;
            transition: background-color 9999s ease-in-out 0s;
        }

  body(class="hold-transition")

    .profile-box
      .card
        .card-body

          h3.text-center.mb-3 Profile

          //if typeof errorMsg !== 'undefined' && errorMsg
          //  .alert.alert-danger= errorMsg
          //
          //if typeof successMsg !== 'undefined' && successMsg
          //  .alert.alert-success= successMsg

          form(action="/profile" method="POST")

            .mb-3
              label Nama Lengkap
              input.form-control.input-gray(
                type="text",
                name="full_name",
                value=user.full_name,
                required
              )

            .mb-3
              label Email
              input.form-control.input-gray(
                type="email",
                name="email",
                value=user.email,
                required
              )

            .mb-3
              label Nomor Telepon
              input.form-control.input-gray(
                type="text",
                name="phone_number",
                value=user.phone_number || '',
                placeholder="08xxxxxxxxxx"
              )

            button.btn.btn-primary.btn-block(type="submit")
              | Simpan Perubahan
          a.d-block.text-center.mt-3(href="/dashboard")
            | Kembali ke Dashboard