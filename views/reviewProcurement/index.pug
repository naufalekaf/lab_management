extends ../layouts/main

block content
    .card.user-card
        .card-body

            form.form-inline.mb-4(method='GET' action='/review-procurement')
                .form-group.mr-2
                    label.text-muted.mr-2(for='year') Filter Tahun:
                    select#year.form-control.input-gray.text-white(name='year' onchange='this.form.submit()' style='background: #1f2937; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px;')
                        option(value='') -- Semua Tahun --
                        each yr in availableYears
                            option(value=yr selected=(yr == selectedYear))= yr
                if selectedYear
                    a.btn.btn-outline-secondary.ml-2(href='/review-procurement' style='border-radius: 8px;') Reset

            //- Bagian 1: Belum Direview (DIAJUKAN)
            .table-responsive.mb-4
                h5.mb-3 Pengadaan — Belum Direview
                if !notReviewed || notReviewed.length === 0
                    p.text-muted Tidak ada pengadaan yang menunggu review.
                else
                    table.table.table-dark.table-hover.table-borderless
                        thead
                            tr
                                th ID
                                th Judul Draft
                                th Tahun
                                th Pemohon
                                th Status
                                th.text-center Aksi
                        tbody
                            each draft in notReviewed
                                tr
                                    td= draft.id
                                    td.font-weight-bold= draft.draft_title
                                    td= draft.procurement_year
                                    td= draft.full_name
                                    td
                                        if draft.draft_status == 'DIAJUKAN'
                                            span.badge.badge-info Diajukan
                                        else
                                            span.badge.badge-light= draft.draft_status
                                    td.text-center
                                        a.btn.btn-info.btn-sm.mr-1(
                                            href=`/review-procurement/${draft.id}`
                                            title='Detail'
                                        )
                                            i.fas.fa-eye

            //- Bagian 2: Sedang Direview (SEDANG_DIREVIEW)
            .table-responsive
                h5.mb-3 Pengadaan — Sedang Direview
                if !reviewing || reviewing.length === 0
                    p.text-muted Tidak ada pengadaan yang sedang direview.
                else
                    table.table.table-dark.table-hover.table-borderless
                        thead
                            tr
                                th ID
                                th Judul Draft
                                th Tahun
                                th Pemohon
                                th Status
                                th.text-center Aksi
                        tbody
                            each draft in reviewing
                                tr
                                    td= draft.id
                                    td.font-weight-bold= draft.draft_title
                                    td= draft.procurement_year
                                    td= draft.full_name
                                    td
                                        if draft.draft_status == 'SEDANG_DIREVIEW'
                                            span.badge.badge-warning Sedang Direview
                                        else
                                            span.badge.badge-light= draft.draft_status
                                    td.text-center
                                        a.btn.btn-info.btn-sm.mr-1(
                                            href=`/review-procurement/${draft.id}`
                                            title='Detail'
                                        )
                                            i.fas.fa-eye
