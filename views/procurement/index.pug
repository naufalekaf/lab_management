extends ../layouts/main

block content
    .card.user-card

        .card-body

            .d-flex.justify-content-between.align-items-center.mb-4

                div
                    h3.text-white.mb-1 Draft Pengadaan
                    p.text-muted.mb-0 Kelola draft usulan pengadaan barang dan peralatan laboratorium.

                a.btn.btn-primary.add-user-btn(
                    href='/procurement/create'
                )
                    | Tambah Draft

            form.form-inline.mb-4(method='GET' action='/procurement')
                .form-group.mr-2
                    label.text-muted.mr-2(for='year') Filter Tahun:
                    select#year.form-control.input-gray.text-white(name='year' onchange='this.form.submit()' style='background: #1f2937; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px;')
                        option(value='') -- Semua Tahun --
                        each yr in availableYears
                            option(value=yr selected=(yr == selectedYear))= yr
                if selectedYear
                    a.btn.btn-outline-secondary.ml-2(href='/procurement' style='border-radius: 8px;') Reset

            .table-responsive

                table.table.table-dark.table-hover.table-borderless

                    thead
                        tr
                            th ID
                            th Judul Draft
                            th Tahun
                            th Status
                            th.text-center Aksi

                    tbody

                        each draft in drafts

                            tr

                                td= draft.id
                                td.font-weight-bold= draft.draft_title
                                td= draft.procurement_year

                                td

                                    if draft.draft_status == 'DRAF'
                                        span.badge.badge-secondary Draft

                                    else if draft.draft_status == 'DIAJUKAN'
                                        span.badge.badge-info Diajukan

                                    else if draft.draft_status == 'DIREVIEW'
                                        span.badge.badge-warning Direview

                                    else if draft.draft_status == 'DISETUJUI'
                                        span.badge.badge-success Disetujui

                                    else if draft.draft_status == 'DITOLAK'
                                        span.badge.badge-danger Ditolak

                                    else
                                        span.badge.badge-light= draft.draft_status

                                td.text-center

                                    a.btn.btn-info.btn-sm.mr-1(
                                        href=`/procurement/${draft.id}`
                                        title='Detail'
                                    )
                                        i.fas.fa-eye

                                    if draft.draft_status == 'DRAF' || draft.draft_status == 'DIAJUKAN'

                                        a.btn.btn-warning.btn-sm.mr-1(
                                            href=`/procurement/${draft.id}/edit`
                                            title='Edit'
                                        )
                                            i.fas.fa-edit

                                        form(
                                            action=`/procurement/${draft.id}/delete`
                                            method='POST'
                                            style='display:inline;'
                                        )

                                            button.btn.btn-danger.btn-sm(
                                                type='submit'
                                                title='Hapus'
                                                onclick="return confirm('Yakin ingin menghapus draft ini?')"
                                            )
                                                i.fas.fa-trash