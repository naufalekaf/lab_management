extends ../layouts/main

block content
  .card.user-card

    .card-body

      h3.text-white.mb-1 Edit Barang
      p.text-muted.mb-4 Perbarui informasi barang dalam draft pengadaan.

      form(
        action=`/procurement-item/${item.id}/update`
        method="POST"
      )

        .form-group

          label.text-light Jenis Barang

          select.form-control.input-gray(
            name="item_type"
          )

            option(
              value="INVENTARIS"
              selected=item.item_type === 'INVENTARIS'
            )
              | Inventaris

            option(
              value="BHP"
              selected=item.item_type === 'BHP'
            )
              | BHP

        .form-group

          label.text-light Nama Barang

          input.form-control.input-gray(
            type="text"
            name="item_name"
            value=item.item_name
            placeholder="Masukkan nama barang"
            required
          )

        .form-group

          label.text-light Jumlah

          input.form-control.input-gray(
            type="number"
            name="quantity"
            value=item.quantity
            placeholder="Masukkan jumlah barang"
            required
          )

        .form-group

          label.text-light Harga Satuan

          input.form-control.input-gray(
            type="number"
            name="estimated_price"
            value=item.estimated_price
            placeholder="Masukkan harga satuan"
            required
          )

        .form-group

          label.text-light Link Pembelian

          input.form-control.input-gray(
            type="text"
            name="purchase_link"
            value=item.purchase_link
            placeholder="Masukkan link pembelian (opsional)"
          )

        .d-flex.justify-content-end.mt-4

          a.btn.btn-secondary.mr-2(
            href="/procurement"
          )
            | Batal

          button.btn.btn-primary(
            type="submit"
          )
            | Simpan Perubahan
