doctype html
html
  head
    title Change Password

    link(
      rel="stylesheet",
      href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css"
    )

    link(
      rel="stylesheet",
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"
    )

    link(
      rel="stylesheet",
      href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css"
    )

    style.
        body {
            background: linear-gradient(135deg, #0f172a, #1e293b);
        }

        .card {
            width: 420px;
            margin: 80px auto;
            border-radius: 16px;
            background: rgba(255,255,255,0.08);
            backdrop-filter: blur(10px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.35);
            border: none;
        }

        .card-body {
            color: #fff;
        }

        .form-control {
            border-radius: 10px;
            height: 45px;
        }

        .btn {
            border-radius: 10px;
            height: 45px;
            font-weight: 600;
        }

        .bdr-radius {
            border-radius: 10px;
        }

        .input-gray {
            background-color: rgb(15, 23, 42); /* abu-abu */
            color: #ffffff; /* warna teks input */
            border: none;
            border-block-color: #1f6feb;
        }

        .input-gray::placeholder {
            color: #ffffff; /* placeholder putih */
            opacity: 1; /* biar tidak pudar */
        }

        /* optional biar lebih enak dilihat */
        .input-gray:focus {
            background-color: rgb(15, 23, 42);
        !important;
            color: #fff !important;
            border-color: #adb5bd !important;
            box-shadow: none !important;
            outline: none !important;
        }

        .input-gray:valid,
        .input-gray:invalid {
            background-color: rgb(15, 23, 42);
        !important;
            color: #fff !important;
        }

        /* 🔥 autofill Chrome (INI PENTING) */
        .input-gray:-webkit-autofill,
        .input-gray:-webkit-autofill:hover,
        .input-gray:-webkit-autofill:focus,
        .input-gray:-webkit-autofill:active {
            -webkit-box-shadow: 0 0 0 1000px #0f172a inset !important;
            -webkit-text-fill-color: #fff !important;
            transition: background-color 9999s ease-in-out 0s;
        }

  body

    .card
      .card-body

        h4.text-center.mb-3 Ganti Password

        if typeof errorMsg !== 'undefined' && errorMsg
          .alert.alert-danger= errorMsg

        form(method="POST", action="/change-password")

          .mb-3
            label Password Lama
            .input-group.bdr-radius.input-gray
              input.form-control.input-gray(
                type="password",
                name="old_password",
                required
              )

              .input-group-append.bdr-radius.input-gray
                .input-group-text.bdr-radius.input-gray.toggle-password(style="cursor:pointer")
                  i.fas.fa-eye.bdr-radius

          .mb-3
            label Password Baru
            .input-group.bdr-radius.input-gray
              input.form-control.input-gray(
                type="password",
                name="new_password",
                required
              )
              .input-group-append.bdr-radius.input-gray
                .input-group-text.bdr-radius.input-gray.toggle-password(style="cursor:pointer")
                  i.fas.fa-eye.bdr-radius
                

          .mb-3
            label Konfirmasi Password
            .input-group.bdr-radius.input-gray
              input.form-control.input-gray(
                type="password",
                name="confirm_password",
                required
            )
              .input-group-append.bdr-radius.input-gray
                .input-group-text.bdr-radius.input-gray.toggle-password(style="cursor:pointer")
                  i.fas.fa-eye.bdr-radius

          button.btn.btn-primary.btn-block(type="submit")
            i.fas.fa-key.mr-1
            | Update Password

        a.d-block.text-center.mt-3(href="/dashboard")
          | Kembali ke Dashboard

    script.
        document.querySelectorAll('.toggle-password').forEach(function (toggle) {
            toggle.addEventListener('click', function () {

                const input = this.closest('.input-group').querySelector('input');
                const icon = this.querySelector('i');

                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('fa-eye');
                    icon.classList.add('fa-eye-slash');
                } else {
                    input.type = 'password';
                    icon.classList.remove('fa-eye-slash');
                    icon.classList.add('fa-eye');
                }
            });
        });